# Local development. Copy this file to .env (gitignored).
# The app loads .env on startup and leaves variables that are already
# set in the environment alone. Production sets those directly and
# does not need this file.
#
# MailHog: SMTP on 1025, web inbox at http://localhost:8025.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025

# Other settings, and the defaults used when they are unset:
# ADDR=:8080
# DB_PATH=data/trackanything.db
# ENV=dev
# BASE_URL=http://localhost:8080
# Production sets TRUSTED_IP_HEADER=Fly-Client-IP because Fly Proxy is the
# trusted public ingress. Leave it unset in development. The app then uses
# the connection address and ignores Fly-Client-IP, CF-Connecting-IP, and
# X-Forwarded-For.
# TRUSTED_IP_HEADER=
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=Track Anything <hello@trackanything.io>
